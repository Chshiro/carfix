# Environment Mode
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgres://carfix:carfix_secret@localhost:5432/carfix_dev

# JWT Configuration
JWT_SECRET=development_jwt_secret_must_be_at_least_32_characters_long_for_security
JWT_REFRESH_SECRET=development_jwt_refresh_secret_must_be_at_least_32_chars_long

# SMS Provider (mock | sms_kz)
SMS_PROVIDER=mock
SMS_API_KEY=

# Telegram Bot (Optional for local dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Object Storage (S3 / Cloudflare R2)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=carfix-uploads
S3_REGION=auto

# Demo Mode (Security: default false, set true only for local demo/testing)
DEMO_MODE=false
